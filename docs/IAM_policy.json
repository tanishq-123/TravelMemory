{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TerraformEC2AndVPC",
      "Effect": "Allow",
      "Action": [
        "ec2:Describe*",
        "ec2:Create*",
        "ec2:Delete*",
        "ec2:Allocate*",
        "ec2:Release*",
        "ec2:Attach*",
        "ec2:Detach*",
        "ec2:Associate*",
        "ec2:Disassociate*",
        "ec2:Authorize*",
        "ec2:Revoke*",
        "ec2:Modify*",
        "ec2:Import*",
        "ec2:RunInstances",
        "ec2:StartInstances",
        "ec2:StopInstances",
        "ec2:TerminateInstances",
        "ec2:GetEbsEncryptionByDefault"
      ],
      "Resource": "*"
    },
    {
      "Sid": "TerraformIAMRoleAndProfile",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:GetRole",
        "iam:TagRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:ListAttachedRolePolicies",
        "iam:ListRolePolicies",
        "iam:ListInstanceProfilesForRole",
        "iam:*InstanceProfile*"
      ],
      "Resource": [
        "arn:aws:iam::758248540507:role/mern-travelmemory-*",
        "arn:aws:iam::758248540507:instance-profile/mern-travelmemory-*"
      ]
    },
    {
      "Sid": "PassRoleToEC2",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::758248540507:role/mern-travelmemory-*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ec2.amazonaws.com"
        }
      }
    }
  ]
}